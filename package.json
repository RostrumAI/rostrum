{
    "name": "rostrum",
    "private": true,
    "type": "module",
    "workspaces": [
        "apps/*",
        "apis/*",
        "packages/*"
    ],
    "trustedDependencies": [
        "@embedded-postgres/darwin-arm64",
        "@embedded-postgres/darwin-x64",
        "@embedded-postgres/linux-arm",
        "@embedded-postgres/linux-arm64",
        "@embedded-postgres/linux-ia32",
        "@embedded-postgres/linux-ppc64",
        "@embedded-postgres/linux-x64",
        "@embedded-postgres/windows-x64"
    ],
    "scripts": {
        "check": "bun run --filter \"*\" typecheck && tsc --noEmit -p tsconfig.scripts.json && bun run check:boundaries",
        "check:boundaries": "bun scripts/check-controller-boundaries.ts",
        "test": "bun test",
        "prepare": "husky",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "lint:staged": "git-format-staged --formatter 'biome check --write --files-ignore-unknown=true --no-errors-on-unmatched --stdin-file-path=\"{}\"' '*' && git-format-staged --no-write --formatter 'biome format --files-ignore-unknown=true --no-errors-on-unmatched --stdin-file-path=\"{}\"' '*'",
        "format": "biome format --write .",
        "review": "bun run scripts/review/index.ts",
        "review:adjudicate": "bun run scripts/review/adjudicate-cli.ts",
        "review:retrospective": "bun run scripts/review/retrospective-cli.ts",
        "docs:setup": "bun run scripts/setup-dev-docs.ts",
        "db:up": "docker compose up -d --wait postgres",
        "db:down": "docker compose down",
        "db:migrate": "bun --filter @rostrum/database migrate"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.7",
        "@types/bun": "^1.4.0",
        "git-format-staged": "^4.0.2",
        "husky": "^9.1.7",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "json-source-map": "^0.6.1"
    }
}
