{
  "name": "rostrum",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "bun run --filter '*' typecheck",
    "check:peers": "bun scripts/check-typescript-peers.ts",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "migrate": "bun run --filter @rostrum/control-api migrate",
    "gen:client": "openapi-typescript apps/control-api/openapi.json -o packages/api-client/src/generated.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
