{
    "workflowFormatVersion": "v1",
    "id": "0192b0a0-7e1d-7000-8000-000000000030",
    "name": "Offset a list of numbers",
    "description": "Loop over numbers, add an offset to each, return the collected sums.",
    "firstNode": "0192b0a0-7e1d-7000-8000-000000000031",
    "inputs": {
        "numbers": { "schema": { "type": "array", "items": { "type": "number" } } },
        "offset": { "schema": { "type": "number" } }
    },
    "steps": [
        {
            "id": "0192b0a0-7e1d-7000-8000-000000000031",
            "type": "task",
            "config": { "operation": "add" },
            "inputs": { "left": { "ref": "inputs.offset" } },
            "outputs": {
                "value": { "type": "number" },
                "results": { "type": "array", "items": { "type": "object" } }
            },
            "loop": {
                "collection": { "ref": "inputs.numbers" },
                "maxIterations": 50,
                "variable": "number",
                "body": "0192b0a0-7e1d-7000-8000-000000000032"
            },
            "successors": ["0192b0a0-7e1d-7000-8000-000000000034"]
        },
        {
            "id": "0192b0a0-7e1d-7000-8000-000000000032",
            "type": "task",
            "config": { "operation": "add" },
            "inputs": {
                "left": { "ref": "loop.number" },
                "right": { "ref": "step.0192b0a0-7e1d-7000-8000-000000000031.value" }
            },
            "outputs": { "value": { "type": "number" } }
        },
        {
            "id": "0192b0a0-7e1d-7000-8000-000000000034",
            "type": "result",
            "inputs": { "sums": { "ref": "step.0192b0a0-7e1d-7000-8000-000000000031.results" } }
        }
    ]
}
