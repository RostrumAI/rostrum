            "type": "task",
            "config": { "operation": "add" },
            "inputs": { "left": { "ref": "inputs.amount" }, "right": { "ref": "inputs.tip" } },
            "outputs": { "value": { "type": "number" } },
            "successors": [
                "0192b0a0-7e1d-7000-8000-000000000022",
