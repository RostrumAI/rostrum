            "outputs": { "value": { "type": "number" } }
        },
        {
            "id": "0192b0a0-7e1d-7000-8000-000000000023",
            "type": "task",
            "config": { "operation": "divide" },
            "inputs": {
                "dividend": { "ref": "step.0192b0a0-7e1d-7000-8000-000000000021.value" },
                "divisor": 2
