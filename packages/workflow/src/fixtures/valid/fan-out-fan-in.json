            "outputs": { "value": { "type": "number" } }
        },
        {
            "id": "0192b0a0-7e1d-7000-8000-000000000027",
            "type": "task",
            "config": { "operation": "add" },
            "inputs": {
                "left": { "ref": "step.0192b0a0-7e1d-7000-8000-000000000022.value" },
                "right": { "ref": "step.0192b0a0-7e1d-7000-8000-000000000023.value" }
