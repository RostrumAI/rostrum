{
    "workflowFormatVersion": "v1",
    "id": "0192b0a0-7e1d-7000-8000-000000000010",
    "name": "Classify a score",
    "firstNode": "0192b0a0-7e1d-7000-8000-000000000011",
    "inputs": {
        "score": { "schema": { "type": "number" } },
        "bonus": { "schema": { "type": "number" }, "default": 0 }
    },
    "steps": [
        {
            "id": "0192b0a0-7e1d-7000-8000-000000000011",
            "type": "task",
            "config": { "operation": "add" },
            "inputs": { "left": { "ref": "inputs.score" }, "right": { "ref": "inputs.bonus" } },
            "outputs": { "value": { "type": "number" } },
            "conditional": "0192b0a0-7e1d-7000-8000-000000000012"
        },
        {
            "id": "0192b0a0-7e1d-7000-8000-000000000013",
            "type": "result",
            "inputs": {
                "decision": "high",
                "score": { "ref": "step.0192b0a0-7e1d-7000-8000-000000000011.value" }
            }
        },
        {
            "id": "0192b0a0-7e1d-7000-8000-000000000014",
            "type": "result",
            "inputs": {
                "decision": "low",
                "score": { "ref": "step.0192b0a0-7e1d-7000-8000-000000000011.value" }
            }
        }
    ],
    "conditionals": [
        {
            "id": "0192b0a0-7e1d-7000-8000-000000000012",
            "dependencies": ["0192b0a0-7e1d-7000-8000-000000000011"],
            "branches": [
                {
                    "label": "high-score",
                    "priority": 0,
                    "condition": {
                        "ref": "step.0192b0a0-7e1d-7000-8000-000000000011.value",
                        "op": "gte",
                        "value": 80
                    },
                    "next": "0192b0a0-7e1d-7000-8000-000000000013"
                },
                {
                    "label": "low-score",
                    "priority": 1,
                    "condition": {
                        "ref": "step.0192b0a0-7e1d-7000-8000-000000000011.value",
                        "op": "lt",
                        "value": 80
                    },
                    "next": "0192b0a0-7e1d-7000-8000-000000000014"
                }
            ],
            "default": {
                "label": "fallback",
                "next": "0192b0a0-7e1d-7000-8000-000000000014"
            }
        }
    ]
}
