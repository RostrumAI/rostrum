{
    "workflowFormatVersion": "v1",
    "id": "0192b0a0-7e1d-7000-8000-000000000040",
    "name": "Conditional with grouped logic",
    "firstNode": "0192b0a0-7e1d-7000-8000-000000000041",
    "inputs": {
        "score": { "schema": { "type": "number" } },
        "weight": { "schema": { "type": "number" } }
    },
    "steps": [
        {
            "id": "0192b0a0-7e1d-7000-8000-000000000041",
            "type": "task",
            "config": { "operation": "divide" },
            "inputs": {
                "dividend": { "ref": "inputs.score" },
                "divisor": { "ref": "inputs.weight" }
            },
            "outputs": { "value": { "type": "number" } },
            "conditional": "0192b0a0-7e1d-7000-8000-000000000042"
        },
        {
            "id": "0192b0a0-7e1d-7000-8000-000000000043",
            "type": "result",
            "inputs": {
                "category": "critical",
                "score": { "ref": "step.0192b0a0-7e1d-7000-8000-000000000041.value" }
            }
        },
        {
            "id": "0192b0a0-7e1d-7000-8000-000000000044",
            "type": "result",
            "inputs": {
                "category": "standard",
                "score": { "ref": "step.0192b0a0-7e1d-7000-8000-000000000041.value" }
            }
        }
    ],
    "conditionals": [
        {
            "id": "0192b0a0-7e1d-7000-8000-000000000042",
            "dependencies": ["0192b0a0-7e1d-7000-8000-000000000041"],
            "branches": [
                {
                    "label": "critical",
                    "priority": 0,
                    "condition": {
                        "all": [
                            {
                                "ref": "step.0192b0a0-7e1d-7000-8000-000000000041.value",
                                "op": "gte",
                                "value": 80
                            },
                            {
                                "any": [
                                    {
                                        "ref": "step.0192b0a0-7e1d-7000-8000-000000000041.value",
                                        "op": "eq",
                                        "value": 90
                                    },
                                    {
                                        "ref": "step.0192b0a0-7e1d-7000-8000-000000000041.value",
                                        "op": "in",
                                        "value": [95, 100]
                                    }
                                ]
                            }
                        ]
                    },
                    "next": "0192b0a0-7e1d-7000-8000-000000000043"
                },
                {
                    "label": "standard",
                    "priority": 1,
                    "condition": {
                        "ref": "step.0192b0a0-7e1d-7000-8000-000000000041.value",
                        "op": "lt",
                        "value": 80
                    },
                    "next": "0192b0a0-7e1d-7000-8000-000000000044"
                }
            ],
            "default": {
                "label": "fallback",
                "next": "0192b0a0-7e1d-7000-8000-000000000044"
            }
        }
    ]
}
