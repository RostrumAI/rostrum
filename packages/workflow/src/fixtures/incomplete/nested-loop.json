{
    "workflowFormatVersion": "v1",
    "id": "0192b0a0-7e1d-7000-8000-00000000008d",
    "name": "Nested loops",
    "firstNode": "0192b0a0-7e1d-7000-8000-00000000008e",
    "inputs": {
        "files": { "type": "array", "items": { "type": "string" } }
    },
    "steps": [
        {
            "id": "0192b0a0-7e1d-7000-8000-00000000008e",
            "type": "task",
            "config": { "operation": "list-files" },
            "inputs": { "files": { "ref": "inputs.files" } },
            "outputs": { "fileList": { "type": "array", "items": { "type": "string" } } },
            "loop": {
                "collection": { "ref": "step.0192b0a0-7e1d-7000-8000-00000000008e.fileList" },
                "maxIterations": 10,
                "variable": "file",
                "body": "0192b0a0-7e1d-7000-8000-00000000008f"
            },
            "successors": ["0192b0a0-7e1d-7000-8000-000000000091"]
        },
        {
            "id": "0192b0a0-7e1d-7000-8000-00000000008f",
            "type": "task",
            "config": { "operation": "analyze-file" },
            "inputs": { "file": { "ref": "loop.file" } },
            "outputs": { "items": { "type": "array", "items": { "type": "string" } } },
            "loop": {
                "collection": { "ref": "step.0192b0a0-7e1d-7000-8000-00000000008f.items" },
                "maxIterations": 5,
                "variable": "item",
                "body": "0192b0a0-7e1d-7000-8000-000000000090"
            }
        },
        {
            "id": "0192b0a0-7e1d-7000-8000-000000000090",
            "type": "task",
            "config": { "operation": "process-item" },
            "inputs": { "item": { "ref": "loop.item" } },
            "outputs": { "done": { "type": "boolean" } }
        },
        {
            "id": "0192b0a0-7e1d-7000-8000-000000000091",
            "type": "result",
            "inputs": {}
        }
    ]
}
