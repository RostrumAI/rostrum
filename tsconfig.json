{
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "allowImportingTsExtensions": true,
        "types": ["@types/bun"],
        "strict": true,
        "noEmit": true,
        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true,
        "noUncheckedIndexedAccess": true,
        "skipLibCheck": true
    },
    // Base configuration for workspace packages. `files: []` keeps the root
    // program empty until workspace packages extend this config (E1-01).
    "files": []
}
