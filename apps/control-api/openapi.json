{
  "openapi": "3.1.0",
  "info": {
    "title": "Rostrum Control API",
    "description": "Code-first OpenAPI 3.1 document generated from TypeBox schemas.",
    "version": "0.1.0"
  },
  "tags": [
    {
      "name": "system"
    }
  ],
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "message",
          "findings"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "code",
                "message",
                "blocking",
                "path"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "blocking": {
                  "type": "boolean"
                },
                "path": {
                  "type": "string"
                },
                "line": {
                  "type": "integer",
                  "description": "One-based line in the saved text."
                },
                "column": {
                  "type": "integer",
                  "description": "One-based column in the saved text."
                },
                "relatedLocations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "path",
                      "message"
                    ],
                    "properties": {
                      "path": {
                        "type": "string"
                      },
                      "message": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "details": {
                  "type": "object",
                  "patternProperties": {
                    "^.*$": {}
                  },
                  "description": "Structured context an automated author can repair without parsing the message."
                }
              },
              "additionalProperties": false
            }
          },
          "currentRevision": {
            "type": "string",
            "description": "The draft's current revision id, present on revision conflicts so a client can retry against it."
          }
        },
        "additionalProperties": false
      },
      "Finding": {
        "type": "object",
        "required": [
          "code",
          "message",
          "blocking",
          "path"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean"
          },
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "description": "One-based line in the saved text."
          },
          "column": {
            "type": "integer",
            "description": "One-based column in the saved text."
          },
          "relatedLocations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "message"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "details": {
            "type": "object",
            "patternProperties": {
              "^.*$": {}
            },
            "description": "Structured context an automated author can repair without parsing the message."
          }
        },
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        },
        "additionalProperties": false
      },
      "CreateDraftRequest": {
        "type": "object",
        "required": [
          "document"
        ],
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional display label for the first revision."
          },
          "document": {
            "description": "The raw workflow JSON document. Drafts accept any syntactically valid JSON, including documents with blocking validation findings; the precise document shape lives in the workflow format, not the transport contract."
          }
        },
        "additionalProperties": false
      },
      "WorkflowRevision": {
        "type": "object",
        "required": [
          "workflowId",
          "revisionId",
          "name",
          "type",
          "content",
          "findings"
        ],
        "properties": {
          "workflowId": {
            "type": "string",
            "description": "The owning draft's id."
          },
          "revisionId": {
            "type": "string",
            "description": "The revision id."
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The author's checkpoint label, when the save carried one."
          },
          "type": {
            "anyOf": [
              {
                "type": "string",
                "const": "save"
              },
              {
                "type": "string",
                "const": "rewind"
              }
            ],
            "description": "How the revision came to exist: an author save or a rewind-appended copy."
          },
          "content": {
            "type": "string",
            "description": "The stored document text. When a save omitted the document id, the response carries the stored text with the id injected."
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "code",
                "message",
                "blocking",
                "path"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "blocking": {
                  "type": "boolean"
                },
                "path": {
                  "type": "string"
                },
                "line": {
                  "type": "integer",
                  "description": "One-based line in the saved text."
                },
                "column": {
                  "type": "integer",
                  "description": "One-based column in the saved text."
                },
                "relatedLocations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "path",
                      "message"
                    ],
                    "properties": {
                      "path": {
                        "type": "string"
                      },
                      "message": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "details": {
                  "type": "object",
                  "patternProperties": {
                    "^.*$": {}
                  },
                  "description": "Structured context an automated author can repair without parsing the message."
                }
              },
              "additionalProperties": false
            },
            "description": "The validation findings snapshot stored with the revision."
          }
        },
        "additionalProperties": false
      },
      "PublishResponse": {
        "type": "object",
        "required": [
          "workflowId",
          "publicationNumber",
          "workflowFormatVersion",
          "digest"
        ],
        "properties": {
          "workflowId": {
            "type": "string"
          },
          "publicationNumber": {
            "type": "integer",
            "description": "The per-workflow publication number."
          },
          "workflowFormatVersion": {
            "type": "string",
            "description": "The exact format version token the published content satisfies."
          },
          "digest": {
            "type": "string",
            "description": "SHA-256 hex over the RFC 8785 canonical form of the document with name and description removed."
          }
        },
        "additionalProperties": false
      },
      "PublicationResponse": {
        "type": "object",
        "required": [
          "publicationNumber",
          "revisionId",
          "workflowFormatVersion",
          "digest",
          "content"
        ],
        "properties": {
          "publicationNumber": {
            "type": "integer"
          },
          "revisionId": {
            "type": "string",
            "description": "The source revision the published bytes came from."
          },
          "workflowFormatVersion": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          },
          "content": {
            "type": "string",
            "description": "The stored canonical text (RFC 8785), full document with metadata members included. Verify by removing name and description, canonicalizing, and hashing SHA-256: the result equals digest."
          }
        },
        "additionalProperties": false
      },
      "RewindRequest": {
        "type": "object",
        "required": [
          "targetRevisionId"
        ],
        "properties": {
          "targetRevisionId": {
            "type": "string",
            "description": "The revision to rewind the draft to."
          }
        },
        "additionalProperties": false
      },
      "SaveRevisionRequest": {
        "type": "object",
        "required": [
          "baseRevision",
          "document"
        ],
        "properties": {
          "baseRevision": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "description": "The revision id the client last saw; the save commits only against it."
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional display label for the new revision."
          },
          "document": {
            "description": "The raw workflow JSON document. Drafts accept any syntactically valid JSON, including documents with blocking validation findings; the precise document shape lives in the workflow format, not the transport contract."
          }
        },
        "additionalProperties": false
      },
      "ValidateResponse": {
        "type": "object",
        "required": [
          "findings",
          "validForPublication"
        ],
        "properties": {
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "code",
                "message",
                "blocking",
                "path"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "blocking": {
                  "type": "boolean"
                },
                "path": {
                  "type": "string"
                },
                "line": {
                  "type": "integer",
                  "description": "One-based line in the saved text."
                },
                "column": {
                  "type": "integer",
                  "description": "One-based column in the saved text."
                },
                "relatedLocations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "path",
                      "message"
                    ],
                    "properties": {
                      "path": {
                        "type": "string"
                      },
                      "message": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "details": {
                  "type": "object",
                  "patternProperties": {
                    "^.*$": {}
                  },
                  "description": "Structured context an automated author can repair without parsing the message."
                }
              },
              "additionalProperties": false
            }
          },
          "validForPublication": {
            "type": "boolean",
            "description": "True when no finding blocks publication."
          }
        },
        "additionalProperties": false
      },
      "WorkflowDocument": {
        "description": "The raw workflow JSON document. Drafts accept any syntactically valid JSON, including documents with blocking validation findings; the precise document shape lives in the workflow format, not the transport contract."
      }
    }
  },
  "paths": {
    "/api/system/health": {
      "get": {
        "operationId": "getApiSystemHealth",
        "tags": [
          "system"
        ],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/workflows": {
      "post": {
        "operationId": "postApiWorkflows",
        "tags": [
          "workflows"
        ],
        "responses": {
          "201": {
            "description": "The draft was created and its first revision stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowRevision"
                }
              }
            }
          },
          "400": {
            "description": "The body is not a valid creation request, or the document is not syntactically valid workflow JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "description": "The creation request body: the workflow document, with an optional revision name.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDraftRequest"
              }
            }
          }
        }
      }
    },
    "/api/workflows/{workflowId}/publish": {
      "post": {
        "operationId": "postApiWorkflowsByWorkflowIdPublish",
        "tags": [
          "workflows"
        ],
        "responses": {
          "200": {
            "description": "The current revision was already published: the response is identical and idempotent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishResponse"
                }
              }
            }
          },
          "201": {
            "description": "The current revision was published and stored as an immutable publication",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishResponse"
                }
              }
            }
          },
          "404": {
            "description": "The workflow does not exist (code not_found), or its current revision does not (code revision_not_found)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "The current revision has blocking validation findings; nothing is created and the body carries the findings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "workflowId",
            "in": "path",
            "required": true,
            "description": "The draft's workflow id.",
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
              "description": "The workflow id."
            }
          }
        ]
      }
    },
    "/api/workflows/{workflowId}": {
      "get": {
        "operationId": "getApiWorkflowsByWorkflowId",
        "tags": [
          "workflows"
        ],
        "responses": {
          "200": {
            "description": "The draft's current revision: stored text plus findings snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowRevision"
                }
              }
            }
          },
          "404": {
            "description": "The workflow does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "workflowId",
            "in": "path",
            "required": true,
            "description": "The draft's workflow id.",
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
              "description": "The workflow id."
            }
          }
        ]
      }
    },
    "/api/workflows/{workflowId}/publications/{publicationNumber}": {
      "get": {
        "operationId": "getApiWorkflowsByWorkflowIdPublicationsByPublicationNumber",
        "tags": [
          "workflows"
        ],
        "responses": {
          "200": {
            "description": "The publication: canonical stored text, verified at retrieval by digest recomputation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicationResponse"
                }
              }
            }
          },
          "404": {
            "description": "The workflow has no such publication",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "workflowId",
            "in": "path",
            "required": true,
            "description": "The draft's workflow id.",
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
              "description": "The workflow id."
            }
          },
          {
            "name": "publicationNumber",
            "in": "path",
            "required": true,
            "description": "The per-workflow publication number.",
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$",
              "description": "The per-workflow publication number."
            }
          }
        ]
      }
    },
    "/api/workflows/{workflowId}/revisions/{revisionId}": {
      "get": {
        "operationId": "getApiWorkflowsByWorkflowIdRevisionsByRevisionId",
        "tags": [
          "workflows"
        ],
        "responses": {
          "200": {
            "description": "The stored revision: exact text plus findings snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowRevision"
                }
              }
            }
          },
          "404": {
            "description": "The workflow or revision does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "workflowId",
            "in": "path",
            "required": true,
            "description": "The draft's workflow id.",
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
              "description": "The workflow id."
            }
          },
          {
            "name": "revisionId",
            "in": "path",
            "required": true,
            "description": "The revision id to retrieve.",
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
              "description": "The revision id."
            }
          }
        ]
      }
    },
    "/api/workflows/{workflowId}/rewind": {
      "post": {
        "operationId": "postApiWorkflowsByWorkflowIdRewind",
        "tags": [
          "workflows"
        ],
        "responses": {
          "200": {
            "description": "The draft now shows the target revision (a rewind to the current revision is a no-op)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowRevision"
                }
              }
            }
          },
          "400": {
            "description": "The body is not a valid rewind request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "The workflow does not exist (code not_found), or the target revision does not (code revision_not_found)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "workflowId",
            "in": "path",
            "required": true,
            "description": "The draft's workflow id.",
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
              "description": "The workflow id."
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "The rewind request body, naming the target revision.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RewindRequest"
              }
            }
          }
        }
      }
    },
    "/api/workflows/{workflowId}/revisions": {
      "put": {
        "operationId": "putApiWorkflowsByWorkflowIdRevisions",
        "tags": [
          "workflows"
        ],
        "responses": {
          "200": {
            "description": "The revision was stored and is the draft's current revision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowRevision"
                }
              }
            }
          },
          "400": {
            "description": "The body is not a valid save request, or the document is not syntactically valid workflow JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "The workflow does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The saved base revision is stale (code revision_conflict, body carries currentRevision and its findings), or the document's embedded id disagrees with the addressed workflow (code identity_conflict)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "workflowId",
            "in": "path",
            "required": true,
            "description": "The draft's workflow id.",
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
              "description": "The workflow id."
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "The save request body: the base revision the client last saw, an optional revision name, and the workflow document. A document that omits the id gets the addressed workflow's id injected.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveRevisionRequest"
              }
            }
          }
        }
      }
    },
    "/api/workflows/validate": {
      "post": {
        "operationId": "postApiWorkflowsValidate",
        "tags": [
          "workflows"
        ],
        "responses": {
          "200": {
            "description": "Validation findings for the submitted document; nothing is saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateResponse"
                }
              }
            }
          },
          "400": {
            "description": "The document is not syntactically valid workflow JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "description": "The raw workflow JSON document to validate.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkflowDocument"
              }
            }
          }
        }
      }
    }
  }
}
