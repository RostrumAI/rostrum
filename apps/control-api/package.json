{
  "name": "@rostrum/control-api",
  "version": "0.0.0-poc",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./src/*.ts": "./src/*.ts",
    "./src/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "bun src/db/migrate-cli.ts",
    "dump-openapi": "bun src/scripts/dump-openapi.ts"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.2.0",
    "@rostrum/workflow-lib": "*",
    "@standard-community/standard-json": "^0.3.5",
    "@standard-community/standard-openapi": "^0.2.9",
    "hono": "^4.13.1",
    "hono-openapi": "^1.3.1",
    "kysely": "^0.29.5",
    "kysely-postgres-js": "^3.0.0",
    "postgres": "^3.4.9",
    "typebox": "^1.3.12"
  }
}
